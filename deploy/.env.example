# Copy this file to .env and change it

# The host name the server is reached at. It needs a DNS record pointing to this machine,
# and ports 80 and 443 need to be reachable for Caddy to get a certificate for it.
ETEBASE_DOMAIN=notes.example.com

# The version of the server image to run. Change it to update.
ETEBASE_VERSION=0.15.0
